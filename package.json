{
  "name": "ze-tour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "generate:audio": "node scripts/generate-audio.mjs",
    "calibrate:economy": "vite-node scripts/simulate-economy.ts --minutes=120 --runs=3 --seed=42 --strategies=casual,skilled --check",
    "simulate:economy": "vite-node scripts/simulate-economy.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  }
}
